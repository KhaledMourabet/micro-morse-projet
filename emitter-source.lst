LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00001         #INCLUDE <P18F2520.INC>        ; load the register and bit names of the PIC18F2520
                      00001         LIST
                      00002 
                      00003 ;==========================================================================
                      00004 ;  MPASM PIC18F2520 processor include
                      00005 ; 
                      00006 ;  (c) Copyright 1999-2007 Microchip Technology, All rights reserved
                      00007 ;==========================================================================
                      00008 
                      01222         LIST
08 1F 1E 83 85 0F C0 000002         CONFIG OSC = INTIO67           ; use the internal oscillator, with RA6 and RA7 as normal I/O pin
                            s
       F E0 0F 40 
                      00003         CONFIG WDT = OFF               ; disable the watchdog timer so it never resets the program
                      00004 
  00000000            00005 CNT_OUT EQU 0X00                   ; address of the outer loop counter (Access RAM)
  00000001            00006 CNT_IN  EQU 0X01                   ; address of the inner loop counter (Access RAM)
                      00007 
000000                00008         ORG 0X00                       ; place the code at the reset vector (address 0)
                      00009 
000000 0E60           00010         MOVLW B'01100000'              ; IRCF2:IRCF0 = 110, which selects 4 MHz for the internal oscilla
                            tor
000002 6ED3           00011         MOVWF OSCCON                   ; apply the 4 MHz clock setting
000004 0E19           00012         MOVLW D'25'                    ; SPBRG value for 9600 baud at 4 MHz with BRGH = 1
000006 6EAF           00013         MOVWF SPBRG                    ; load the baud rate generator
000008 0E24           00014         MOVLW B'00100100'              ; TXEN = 1 (enable transmit), SYNC = 0 (asynchronous), BRGH = 1 (
                            high speed)
00000A 6EAC           00015         MOVWF TXSTA                    ; configure the transmitter
00000C 0E90           00016         MOVLW B'10010000'              ; SPEN = 1 (enable serial port), CREN = 1 (enable continuous rece
                            ive)
00000E 6EAB           00017         MOVWF RCSTA                    ; configure the receiver and turn on the serial port
000010 908B           00018         BCF LATC, 0                    ; set the RC0 output latch to 0 so the LED starts off
000012 9094           00019         BCF TRISC, 0                   ; make RC0 an output (0 = output)
                      00020 
000014                00021 MAIN_LOOP                          ; label: start of the dot and dash test
000014 D803           00022         RCALL DOT                      ; send one dot (1T high, 1T low)
000016 D807           00023         RCALL DASH                     ; send one dash (3T high, 1T low)
000018 D815           00024         RCALL DELAY_3T                 ; temporary pause so each dot-dash pair is easy to see on the osc
                            illoscope
00001A D7FC           00025         BRA MAIN_LOOP                  ; repeat forever
                      00026 
00001C                00027 DOT                                ; label: dot routine
00001C 808B           00028         BSF LATC, 0                    ; set RC0 high, signal and LED on
00001E D808           00029         RCALL DELAY_1T                 ; keep it high for 1T (100 ms)
000020 908B           00030         BCF LATC, 0                    ; set RC0 low, signal and LED off
000022 D806           00031         RCALL DELAY_1T                 ; keep it low for 1T, the gap after an element
000024 0012           00032         RETURN                         ; go back to the caller
                      00033 
000026                00034 DASH                               ; label: dash routine
000026 808B           00035         BSF LATC, 0                    ; set RC0 high, signal and LED on
000028 D80D           00036         RCALL DELAY_3T                 ; keep it high for 3T (300 ms)
00002A 908B           00037         BCF LATC, 0                    ; set RC0 low, signal and LED off
00002C D801           00038         RCALL DELAY_1T                 ; keep it low for 1T, the gap after an element
MPASM  5.34                EMITTER-SOURCE.ASM   11-7-2026  21:23:02         PAGE  2


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

00002E 0012           00039         RETURN                         ; go back to the caller
                      00040 
000030                00041 DELAY_1T                           ; label: 1T delay routine, 100 ms at 4 MHz
000030 0E64           00042         MOVLW D'100'                   ; load 100 into W (100 passes of 1 ms each)
000032 6E00           00043         MOVWF CNT_OUT                  ; store it in the outer counter
000034                00044 OUTER_LOOP                         ; label: start of one 1 ms pass
000034 0EF9           00045         MOVLW D'249'                   ; load 249 into W (number of inner iterations)
000036 6E01           00046         MOVWF CNT_IN                   ; store it in the inner counter
000038                00047 INNER_LOOP                         ; label: start of the inner loop
000038 0000           00048         NOP                            ; do nothing for 1 cycle, so each inner turn takes 4 cycles
00003A 2E01           00049         DECFSZ CNT_IN, F               ; decrement the inner counter, skip the next line when it reaches
                             0
00003C D7FD           00050         BRA INNER_LOOP                 ; inner counter not 0 yet, repeat
00003E 2E00           00051         DECFSZ CNT_OUT, F              ; decrement the outer counter, skip the next line when it reaches
                             0
000040 D7F9           00052         BRA OUTER_LOOP                 ; outer counter not 0 yet, do another pass
000042 0012           00053         RETURN                         ; delay finished, go back to the caller
                      00054 
000044                00055 DELAY_3T                           ; label: 3T delay routine (300 ms)
000044 DFF5           00056         RCALL DELAY_1T                 ; wait 1T
000046 DFF4           00057         RCALL DELAY_1T                 ; wait another 1T
000048 DFF3           00058         RCALL DELAY_1T                 ; wait a third 1T
00004A 0012           00059         RETURN                         ; go back to the caller
                      00060 
00004C                00061 DELAY_7T                           ; label: 7T delay routine (700 ms), used later for the gap between wo
                            rds
00004C DFFB           00062         RCALL DELAY_3T                 ; wait 3T
00004E DFFA           00063         RCALL DELAY_3T                 ; wait another 3T
000050 DFEF           00064         RCALL DELAY_1T                 ; wait 1T, for a total of 7T
000052 0012           00065         RETURN                         ; go back to the caller
                      00066 
                      00067         END                            ; end of the source file
