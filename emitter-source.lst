0000CC                00134 DOT                                ; label: dot routine
0000CC 808B           00135         BSF LATC, 0                    ; set RC0 high, signal and LED on
0000CE D80E           00136         RCALL DELAY_1T                 ; keep it high for 1T (100 ms)
0000D0 908B           00137         BCF LATC, 0                    ; set RC0 low, signal and LED off
0000D2 D80C           00138         RCALL DELAY_1T                 ; keep it low for 1T, the gap after an element
0000D4 0012           00139         RETURN                         ; go back to the caller
                      00140 
0000D6                00141 DASH                               ; label: dash routine
0000D6 808B           00142         BSF LATC, 0                    ; set RC0 high, signal and LED on
0000D8 D813           00143         RCALL DELAY_3T                 ; keep it high for 3T (300 ms)
0000DA 908B           00144         BCF LATC, 0                    ; set RC0 low, signal and LED off
0000DC D807           00145         RCALL DELAY_1T                 ; keep it low for 1T, the gap after an element
0000DE 0012           00146         RETURN                         ; go back to the caller
                      00147 
0000E0                00148 CHAR_GAP                           ; label: gap between characters (2T added to the 1T already done)
0000E0 D805           00149         RCALL DELAY_1T                 ; wait 1T
0000E2 D804           00150         RCALL DELAY_1T                 ; wait another 1T, so 2T in total
0000E4 0012           00151         RETURN                         ; go back to the caller
                      00152 
0000E6                00153 WORD_GAP                           ; label: gap between words (4T added to the 3T already done)
0000E6 D80C           00154         RCALL DELAY_3T                 ; wait 3T
0000E8 D801           00155         RCALL DELAY_1T                 ; wait 1T more, so 4T in total
0000EA 0012           00156         RETURN                         ; go back to the caller
                      00157 
0000EC                00158 DELAY_1T                           ; label: 1T delay routine, 100 ms at 4 MHz
0000EC 0E64           00159         MOVLW D'100'                   ; load 100 into W (100 passes of 1 ms each)
0000EE 6E00           00160         MOVWF CNT_OUT                  ; store it in the outer counter
0000F0                00161 OUTER_LOOP                         ; label: start of one 1 ms pass
0000F0 0EF9           00162         MOVLW D'249'                   ; load 249 into W (number of inner iterations)
0000F2 6E01           00163         MOVWF CNT_IN                   ; store it in the inner counter
0000F4                00164 INNER_LOOP                         ; label: start of the inner loop
0000F4 0000           00165         NOP                            ; do nothing for 1 cycle, so each inner turn takes 4 cycles
0000F6 2E01           00166         DECFSZ CNT_IN, F               ; decrement the inner counter, skip the next line when it reaches
                             0
0000F8 D7FD           00167         BRA INNER_LOOP                 ; inner counter not 0 yet, repeat
0000FA 2E00           00168         DECFSZ CNT_OUT, F              ; decrement the outer counter, skip the next line when it reaches
                             0
0000FC D7F9           00169         BRA OUTER_LOOP                 ; outer counter not 0 yet, do another pass
0000FE 0012           00170         RETURN                         ; delay finished, go back to the caller
                      00171 
000100                00172 DELAY_3T                           ; label: 3T delay routine (300 ms)
000100 DFF5           00173         RCALL DELAY_1T                 ; wait 1T
000102 DFF4           00174         RCALL DELAY_1T                 ; wait another 1T
000104 DFF3           00175         RCALL DELAY_1T                 ; wait a third 1T
000106 0012           00176         RETURN                         ; go back to the caller
                      00177 
