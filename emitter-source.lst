                      00141 
0000D8                00142 CHAR_GAP                           ; label: gap between characters (2T added to the 1T already done)
0000D8 D805           00143         RCALL DELAY_1T                 ; wait 1T
0000DA D804           00144         RCALL DELAY_1T                 ; wait another 1T, so 2T in total
