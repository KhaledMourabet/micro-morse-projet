                      01222         LIST
08 1F 1E 83 85 0F C0 000002         CONFIG OSC = INTIO67           ; use the internal oscillator, with RA6 and RA7 as normal I/O pin
                            s
       F E0 0F 40 
                      00003         CONFIG WDT = OFF               ; disable the watchdog timer so it never resets the program
                      00004 
  00000000            00005 CNT_OUT  EQU 0X00                  ; address of the outer loop counter (Access RAM)
  00000001            00006 CNT_IN   EQU 0X01                  ; address of the inner loop counter (Access RAM)
  00000002            00007 CODE_REG EQU 0X02                  ; address of the Morse code byte currently being sent
  00000003            00008 CHAR_IN  EQU 0X03                  ; address of the character being converted, then its table index
  00000004            00009 HEAD     EQU 0X04                  ; address of the buffer write index (0 to 15), changed only by the IS
                            R
  00000005            00010 TAIL     EQU 0X05                  ; address of the buffer read index (0 to 15), changed only by the mai
                            n loop
  00000020            00011 BUFFER   EQU 0X20                  ; start address of the 16-byte receive buffer (0x20 to 0x2F)
  00000006            00012 RX_CHAR  EQU 0X06                  ; address of the received character, kept while the ISR works with W
                      00013 
000000                00014         ORG 0X00                       ; place the code at the reset vector (address 0)
000000 EF18 F000      00015         GOTO START                     ; jump over the interrupt vector to the start of the program
000008                00016         ORG 0X08                       ; place the next code at the interrupt vector (address 8)
                      00017 
000008                00018 ISR                                ; label: interrupt routine, runs whenever a character is received
000008 50AE           00019         MOVF RCREG, W                  ; read the received character into W (this also clears RCIF)
00000A 6E06           00020         MOVWF RX_CHAR                  ; save it, because W will be reused below
00000C                00021 ECHO_WAIT                          ; label: wait until the transmitter can accept a character
00000C A89E           00022         BTFSS PIR1, TXIF               ; skip the next line if TXIF = 1 (TXREG is empty)
00000E D7FE           00023         BRA ECHO_WAIT                  ; transmitter still busy, check again (at most about 1 ms)
000010 6EAD           00024         MOVWF TXREG                    ; send the character back to the terminal (W still holds it)
000012 2804           00025         INCF HEAD, W                   ; W = head + 1, the next write index
000014 0B0F           00026         ANDLW 0X0F                     ; wrap the index back to 0 after 15
000016 6205           00027         CPFSEQ TAIL                    ; skip the next line if the next index equals tail (buffer full)
000018 D001           00028         BRA STORE                      ; buffer not full, go and store the character
00001A 0011           00029         RETFIE FAST                    ; buffer full: the character is dropped, return and restore W, ST
                            ATUS and BSR
00001C                00030 STORE                              ; label: there is room in the buffer
00001C EE00 F020      00031         LFSR 0, BUFFER                 ; point FSR0 to the start of the buffer
000020 5004           00032         MOVF HEAD, W                   ; W = write index
000022 26E9           00033         ADDWF FSR0L, F                 ; FSR0 now points to the free slot (buffer + head)
000024 5006           00034         MOVF RX_CHAR, W                ; get the saved character back into W
000026 6EEF           00035         MOVWF INDF0                    ; store it in the buffer slot that FSR0 points to
000028 2804           00036         INCF HEAD, W                   ; W = head + 1
00002A 0B0F           00037         ANDLW 0X0F                     ; wrap the index back to 0 after 15
00002C 6E04           00038         MOVWF HEAD                     ; save the new write index
00002E 0011           00039         RETFIE FAST                    ; return from the interrupt, restoring W, STATUS and BSR automati
