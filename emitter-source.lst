000030                00041 START                              ; label: start of the main program
000030 0E60           00042         MOVLW B'01100000'              ; IRCF2:IRCF0 = 110, which selects 4 MHz for the internal oscilla
                            tor
000032 6ED3           00043         MOVWF OSCCON                   ; apply the 4 MHz clock setting
000034 0E19           00044         MOVLW D'25'                    ; SPBRG value for 9600 baud at 4 MHz with BRGH = 1
000036 6EAF           00045         MOVWF SPBRG                    ; load the baud rate generator
000038 0E24           00046         MOVLW B'00100100'              ; TXEN = 1 (enable transmit), SYNC = 0 (asynchronous), BRGH = 1 (
                            high speed)
00003A 6EAC           00047         MOVWF TXSTA                    ; configure the transmitter
00003C 0E90           00048         MOVLW B'10010000'              ; SPEN = 1 (enable serial port), CREN = 1 (enable continuous rece
                            ive)
00003E 6EAB           00049         MOVWF RCSTA                    ; configure the receiver and turn on the serial port
000040 908B           00050         BCF LATC, 0                    ; set the RC0 output latch to 0 so the LED starts off
000042 9094           00051         BCF TRISC, 0                   ; make RC0 an output (0 = output)
000044 6A04           00052         CLRF HEAD                      ; start with the write index at 0 (RAM is not cleared at power-up
                            )
000046 6A05           00053         CLRF TAIL                      ; start with the read index at 0, so the buffer is empty
000048 8A9D           00054         BSF PIE1, RCIE                 ; enable the UART receive interrupt
00004A 0EC0           00055         MOVLW B'11000000'              ; GIE = 1 (global interrupts on), PEIE = 1 (peripheral interrupts
                             on)
00004C 6EF2           00056         MOVWF INTCON                   ; turn the interrupts on
                      00057 
00004E                00058 MAIN_LOOP                          ; label: start of the loop that takes characters from the buffer
00004E 5005           00059         MOVF TAIL, W                   ; W = read index
000050 6204           00060         CPFSEQ HEAD                    ; skip the next line if head equals tail (buffer empty)
000052 D001           00061         BRA TAKE                       ; buffer not empty, go and take a character
000054 D7FC           00062         BRA MAIN_LOOP                  ; buffer empty, check again
000056                00063 TAKE                               ; label: there is a character waiting in the buffer
000056 EE10 F020      00064         LFSR 1, BUFFER                 ; point FSR1 to the start of the buffer
00005A 5005           00065         MOVF TAIL, W                   ; W = read index
00005C 26E1           00066         ADDWF FSR1L, F                 ; FSR1 now points to the oldest character (buffer + tail)
00005E 50E7           00067         MOVF INDF1, W                  ; W = the oldest character
000060 6E03           00068         MOVWF CHAR_IN                  ; save the character
000062 2805           00069         INCF TAIL, W                   ; W = tail + 1
000064 0B0F           00070         ANDLW 0X0F                     ; wrap the index back to 0 after 15
000066 6E05           00071         MOVWF TAIL                     ; save the new read index, which frees the slot
000068 0E20           00072         MOVLW ' '                      ; load the ASCII code of a space (0x20)
00006A 6203           00073         CPFSEQ CHAR_IN                 ; skip the next line if the character is a space
00006C D002           00074         BRA NOT_SPACE                  ; not a space, go and convert it
00006E D83B           00075         RCALL WORD_GAP                 ; space: add 4T of low to reach the 7T gap between words
000070 D7EE           00076         BRA MAIN_LOOP                  ; go back and look for the next character
000072                00077 NOT_SPACE                          ; label: the character is not a space
000072 D806           00078         RCALL GET_CODE                 ; convert char_in into its Morse code byte (W = 0 if invalid)
000074 66E8           00079         TSTFSZ WREG                    ; skip the next line if W = 0 (invalid character)
000076 D001           00080         BRA PLAY                       ; valid character, go and play it
000078 D7EA           00081         BRA MAIN_LOOP                  ; invalid character: ignore it and look for the next one
00007A                00082 PLAY                               ; label: the character is valid
00007A D81E           00083         RCALL SEND_CODE                ; play the code as dots and dashes on RC0
00007C D831           00084         RCALL CHAR_GAP                 ; add 2T of low, so the total low after the last element is 3T
00007E D7E7           00085         BRA MAIN_LOOP                  ; go back and look for the next character
                      00086 
