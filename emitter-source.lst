000080                00087 GET_CODE                           ; label: converts char_in into its Morse code byte in W (0 if invalid
                            )
000080 0E2F           00088         MOVLW '/'                      ; load 0x2F, the character just below '0'
000082 6403           00089         CPFSGT CHAR_IN                 ; skip the next line if char_in > '/' (the character is '0' or ab
                            ove)
000084 0C00           00090         RETLW 0                        ; below '0': invalid, return 0
000086 0E3A           00091         MOVLW ':'                      ; load 0x3A, the character just above '9'
000088 6003           00092         CPFSLT CHAR_IN                 ; skip the next line if char_in < ':' (the character is '9' or be
                            low)
00008A D003           00093         BRA CHECK_LETTER               ; above '9': it may be a letter
00008C 0E16           00094         MOVLW D'22'                    ; '0' is 48, and 48 - 22 = 26, the table index of '0'
00008E 5E03           00095         SUBWF CHAR_IN, F               ; char_in = digit index (26 to 35)
000090 D008           00096         BRA READ_TABLE                 ; go and read the table
000092                00097 CHECK_LETTER                       ; label: the character is above '9'
000092 0E40           00098         MOVLW '@'                      ; load 0x40, the character just below 'A'
000094 6403           00099         CPFSGT CHAR_IN                 ; skip the next line if char_in > '@' (the character is 'A' or ab
                            ove)
000096 0C00           00100         RETLW 0                        ; between ':' and '@': invalid, return 0
000098 0E5B           00101         MOVLW '['                      ; load 0x5B, the character just above 'Z'
00009A 6003           00102         CPFSLT CHAR_IN                 ; skip the next line if char_in < '[' (the character is 'Z' or be
                            low)
00009C 0C00           00103         RETLW 0                        ; above 'Z' (lowercase included): invalid, return 0
00009E 0E41           00104         MOVLW 'A'                      ; load the ASCII code of 'A' (0x41)
0000A0 5E03           00105         SUBWF CHAR_IN, F               ; char_in = letter index (0 to 25)
0000A2                00106 READ_TABLE                         ; label: char_in now holds the table index
0000A2 0E08           00107         MOVLW LOW MORSE_TABLE          ; load the low byte of the table address
0000A4 6EF6           00108         MOVWF TBLPTRL                  ; store it in the table pointer
0000A6 0E01           00109         MOVLW HIGH MORSE_TABLE         ; load the high byte of the table address
0000A8 6EF7           00110         MOVWF TBLPTRH                  ; store it in the table pointer
0000AA 5003           00111         MOVF CHAR_IN, W                ; load the index into W
0000AC 26F6           00112         ADDWF TBLPTRL, F               ; point to the table start + index (low byte)
0000AE 0E00           00113         MOVLW 0                        ; load 0 into W (movlw does not change C)
0000B0 22F7           00114         ADDWFC TBLPTRH, F              ; add the carry from the low byte to the high byte
0000B2 0008           00115         TBLRD*                         ; read the table byte at that address into TABLAT
0000B4 50F5           00116         MOVF TABLAT, W                 ; copy the Morse code byte into W
0000B6 0012           00117         RETURN                         ; go back to the caller
                      00118 
0000B8                00119 SEND_CODE                          ; label: plays the Morse code byte in W as dots and dashes
0000B8 6E02           00120         MOVWF CODE_REG                 ; save the code byte
0000BA                00121 NEXT_ELEM                          ; label: start of one element (dot or dash)
0000BA 90D8           00122         BCF STATUS, C                  ; clear the carry so a 0 enters bit 7 during the shift
0000BC 3202           00123         RRCF CODE_REG, F               ; shift right: the old bit 0 (the current element) goes into C
0000BE E202           00124         BC SEND_DASH                   ; if C = 1 the element is a dash
0000C0 D805           00125         RCALL DOT                      ; C = 0: send a dot
0000C2 D001           00126         BRA ELEM_DONE                  ; skip the dash call
0000C4                00127 SEND_DASH                          ; label: the element is a dash
0000C4 D808           00128         RCALL DASH                     ; send a dash
0000C6                00129 ELEM_DONE                          ; label: element finished
0000C6 0402           00130         DECF CODE_REG, W               ; W = code_reg - 1, which is 0 when only the end marker bit is le
                            ft
0000C8 E1F8           00131         BNZ NEXT_ELEM                  ; not 0: elements remain, send the next one
0000CA 0012           00132         RETURN                         ; only the marker is left, the character is finished
                      00133 
