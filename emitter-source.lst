                      01222         LIST
08 1F 1E 83 85 0F C0 000002         CONFIG OSC = INTIO67           ; use the internal oscillator, with RA6 and RA7 as normal I/O pin
                            s
       F E0 0F 40 
                      00003         CONFIG WDT = OFF               ; disable the watchdog timer so it never resets the program
                      00004 
  00000000            00005 CNT_OUT  EQU 0X00                  ; address of the outer loop counter (Access RAM)
  00000001            00006 CNT_IN   EQU 0X01                  ; address of the inner loop counter (Access RAM)
  00000002            00007 CODE_REG EQU 0X02                  ; address of the Morse code byte currently being sent
  00000003            00008 CHAR_IN  EQU 0X03                  ; address of the character being converted, then its table index
  00000004            00009 HEAD     EQU 0X04                  ; address of the buffer write index (0 to 15), changed only by the IS
                            R
  00000005            00010 TAIL     EQU 0X05                  ; address of the buffer read index (0 to 15), changed only by the mai
                            n loop
  00000020            00011 BUFFER   EQU 0X20                  ; start address of the 16-byte receive buffer (0x20 to 0x2F)
                      00012 
000000                00013         ORG 0X00                       ; place the code at the reset vector (address 0)
000000 EF14 F000      00014         GOTO START                     ; jump over the interrupt vector to the start of the program
000008                00015         ORG 0X08                       ; place the next code at the interrupt vector (address 8)
                      00016 
000008                00017 ISR                                ; label: interrupt routine, runs whenever a character is received
000008 2804           00018         INCF HEAD, W                   ; W = head + 1, the next write index
00000A 0B0F           00019         ANDLW 0X0F                     ; wrap the index back to 0 after 15
00000C 6205           00020         CPFSEQ TAIL                    ; skip the next line if the next index equals tail (buffer full)
00000E D002           00021         BRA STORE                      ; buffer not full, go and store the character
000010 50AE           00022         MOVF RCREG, W                  ; buffer full: read and discard the character (this also clears R
                            CIF)
000012 0011           00023         RETFIE FAST                    ; return from the interrupt, restoring W, STATUS and BSR automati
                            cally
000014                00024 STORE                              ; label: there is room in the buffer
000014 EE00 F020      00025         LFSR 0, BUFFER                 ; point FSR0 to the start of the buffer
000018 5004           00026         MOVF HEAD, W                   ; W = write index
00001A 26E9           00027         ADDWF FSR0L, F                 ; FSR0 now points to the free slot (buffer + head)
00001C 50AE           00028         MOVF RCREG, W                  ; read the received character (this also clears RCIF)
00001E 6EEF           00029         MOVWF INDF0                    ; store it in the buffer slot that FSR0 points to
000020 2804           00030         INCF HEAD, W                   ; W = head + 1
000022 0B0F           00031         ANDLW 0X0F                     ; wrap the index back to 0 after 15
000024 6E04           00032         MOVWF HEAD                     ; save the new write index
000026 0011           00033         RETFIE FAST                    ; return from the interrupt, restoring W, STATUS and BSR automati
                            cally
                      00034 
000028                00035 START                              ; label: start of the main program
000028 0E60           00036         MOVLW B'01100000'              ; IRCF2:IRCF0 = 110, which selects 4 MHz for the internal oscilla
                            tor
