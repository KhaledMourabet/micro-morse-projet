00002A 6ED3           00037         MOVWF OSCCON                   ; apply the 4 MHz clock setting
00002C 0E19           00038         MOVLW D'25'                    ; SPBRG value for 9600 baud at 4 MHz with BRGH = 1
00002E 6EAF           00039         MOVWF SPBRG                    ; load the baud rate generator
000030 0E24           00040         MOVLW B'00100100'              ; TXEN = 1 (enable transmit), SYNC = 0 (asynchronous), BRGH = 1 (
                            high speed)
000032 6EAC           00041         MOVWF TXSTA                    ; configure the transmitter
000034 0E90           00042         MOVLW B'10010000'              ; SPEN = 1 (enable serial port), CREN = 1 (enable continuous rece
                            ive)
000036 6EAB           00043         MOVWF RCSTA                    ; configure the receiver and turn on the serial port
000038 908B           00044         BCF LATC, 0                    ; set the RC0 output latch to 0 so the LED starts off
00003A 9094           00045         BCF TRISC, 0                   ; make RC0 an output (0 = output)
00003C 6A04           00046         CLRF HEAD                      ; start with the write index at 0 (RAM is not cleared at power-up
                            )
00003E 6A05           00047         CLRF TAIL                      ; start with the read index at 0, so the buffer is empty
000040 8A9D           00048         BSF PIE1, RCIE                 ; enable the UART receive interrupt
000042 0EC0           00049         MOVLW B'11000000'              ; GIE = 1 (global interrupts on), PEIE = 1 (peripheral interrupts
                             on)
000044 6EF2           00050         MOVWF INTCON                   ; turn the interrupts on
                      00051 
000046                00052 MAIN_LOOP                          ; label: start of the loop that takes characters from the buffer
000046 5005           00053         MOVF TAIL, W                   ; W = read index
000048 6204           00054         CPFSEQ HEAD                    ; skip the next line if head equals tail (buffer empty)
00004A D001           00055         BRA TAKE                       ; buffer not empty, go and take a character
00004C D7FC           00056         BRA MAIN_LOOP                  ; buffer empty, check again
00004E                00057 TAKE                               ; label: there is a character waiting in the buffer
00004E EE10 F020      00058         LFSR 1, BUFFER                 ; point FSR1 to the start of the buffer
000052 5005           00059         MOVF TAIL, W                   ; W = read index
000054 26E1           00060         ADDWF FSR1L, F                 ; FSR1 now points to the oldest character (buffer + tail)
000056 50E7           00061         MOVF INDF1, W                  ; W = the oldest character
000058 6E03           00062         MOVWF CHAR_IN                  ; save the character
00005A 2805           00063         INCF TAIL, W                   ; W = tail + 1
00005C 0B0F           00064         ANDLW 0X0F                     ; wrap the index back to 0 after 15
00005E 6E05           00065         MOVWF TAIL                     ; save the new read index, which frees the slot
000060 0E20           00066         MOVLW ' '                      ; load the ASCII code of a space (0x20)
000062 6203           00067         CPFSEQ CHAR_IN                 ; skip the next line if the character is a space
000064 D002           00068         BRA NOT_SPACE                  ; not a space, go and convert it
000066 D83B           00069         RCALL WORD_GAP                 ; space: add 4T of low to reach the 7T gap between words
000068 D7EE           00070         BRA MAIN_LOOP                  ; go back and look for the next character
00006A                00071 NOT_SPACE                          ; label: the character is not a space
00006A D806           00072         RCALL GET_CODE                 ; convert char_in into its Morse code byte (W = 0 if invalid)
00006C 66E8           00073         TSTFSZ WREG                    ; skip the next line if W = 0 (invalid character)
00006E D001           00074         BRA PLAY                       ; valid character, go and play it
000070 D7EA           00075         BRA MAIN_LOOP                  ; invalid character: ignore it and look for the next one
000072                00076 PLAY                               ; label: the character is valid
000072 D81E           00077         RCALL SEND_CODE                ; play the code as dots and dashes on RC0
000074 D831           00078         RCALL CHAR_GAP                 ; add 2T of low, so the total low after the last element is 3T
000076 D7E7           00079         BRA MAIN_LOOP                  ; go back and look for the next character
                      00080 
000078                00081 GET_CODE                           ; label: converts char_in into its Morse code byte in W (0 if invalid
                            )
000078 0E2F           00082         MOVLW '/'                      ; load 0x2F, the character just below '0'
00007A 6403           00083         CPFSGT CHAR_IN                 ; skip the next line if char_in > '/' (the character is '0' or ab
                            ove)
