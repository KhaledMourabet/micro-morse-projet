00007C 0C00           00084         RETLW 0                        ; below '0': invalid, return 0
00007E 0E3A           00085         MOVLW ':'                      ; load 0x3A, the character just above '9'
000080 6003           00086         CPFSLT CHAR_IN                 ; skip the next line if char_in < ':' (the character is '9' or be
                            low)
000082 D003           00087         BRA CHECK_LETTER               ; above '9': it may be a letter
000084 0E16           00088         MOVLW D'22'                    ; '0' is 48, and 48 - 22 = 26, the table index of '0'
000086 5E03           00089         SUBWF CHAR_IN, F               ; char_in = digit index (26 to 35)
000088 D008           00090         BRA READ_TABLE                 ; go and read the table
00008A                00091 CHECK_LETTER                       ; label: the character is above '9'
00008A 0E40           00092         MOVLW '@'                      ; load 0x40, the character just below 'A'
00008C 6403           00093         CPFSGT CHAR_IN                 ; skip the next line if char_in > '@' (the character is 'A' or ab
                            ove)
00008E 0C00           00094         RETLW 0                        ; between ':' and '@': invalid, return 0
000090 0E5B           00095         MOVLW '['                      ; load 0x5B, the character just above 'Z'
000092 6003           00096         CPFSLT CHAR_IN                 ; skip the next line if char_in < '[' (the character is 'Z' or be
                            low)
000094 0C00           00097         RETLW 0                        ; above 'Z' (lowercase included): invalid, return 0
000096 0E41           00098         MOVLW 'A'                      ; load the ASCII code of 'A' (0x41)
000098 5E03           00099         SUBWF CHAR_IN, F               ; char_in = letter index (0 to 25)
00009A                00100 READ_TABLE                         ; label: char_in now holds the table index
00009A 0E00           00101         MOVLW LOW MORSE_TABLE          ; load the low byte of the table address
00009C 6EF6           00102         MOVWF TBLPTRL                  ; store it in the table pointer
00009E 0E01           00103         MOVLW HIGH MORSE_TABLE         ; load the high byte of the table address
0000A0 6EF7           00104         MOVWF TBLPTRH                  ; store it in the table pointer
0000A2 5003           00105         MOVF CHAR_IN, W                ; load the index into W
0000A4 26F6           00106         ADDWF TBLPTRL, F               ; point to the table start + index (low byte)
0000A6 0E00           00107         MOVLW 0                        ; load 0 into W (movlw does not change C)
0000A8 22F7           00108         ADDWFC TBLPTRH, F              ; add the carry from the low byte to the high byte
0000AA 0008           00109         TBLRD*                         ; read the table byte at that address into TABLAT
0000AC 50F5           00110         MOVF TABLAT, W                 ; copy the Morse code byte into W
0000AE 0012           00111         RETURN                         ; go back to the caller
                      00112 
0000B0                00113 SEND_CODE                          ; label: plays the Morse code byte in W as dots and dashes
0000B0 6E02           00114         MOVWF CODE_REG                 ; save the code byte
0000B2                00115 NEXT_ELEM                          ; label: start of one element (dot or dash)
0000B2 90D8           00116         BCF STATUS, C                  ; clear the carry so a 0 enters bit 7 during the shift
0000B4 3202           00117         RRCF CODE_REG, F               ; shift right: the old bit 0 (the current element) goes into C
0000B6 E202           00118         BC SEND_DASH                   ; if C = 1 the element is a dash
0000B8 D805           00119         RCALL DOT                      ; C = 0: send a dot
0000BA D001           00120         BRA ELEM_DONE                  ; skip the dash call
0000BC                00121 SEND_DASH                          ; label: the element is a dash
0000BC D808           00122         RCALL DASH                     ; send a dash
0000BE                00123 ELEM_DONE                          ; label: element finished
0000BE 0402           00124         DECF CODE_REG, W               ; W = code_reg - 1, which is 0 when only the end marker bit is le
                            ft
0000C0 E1F8           00125         BNZ NEXT_ELEM                  ; not 0: elements remain, send the next one
0000C2 0012           00126         RETURN                         ; only the marker is left, the character is finished
                      00127 
0000C4                00128 DOT                                ; label: dot routine
0000C4 808B           00129         BSF LATC, 0                    ; set RC0 high, signal and LED on
0000C6 D80E           00130         RCALL DELAY_1T                 ; keep it high for 1T (100 ms)
0000C8 908B           00131         BCF LATC, 0                    ; set RC0 low, signal and LED off
0000CA D80C           00132         RCALL DELAY_1T                 ; keep it low for 1T, the gap after an element
