                      00146 
0000DE                00147 WORD_GAP                           ; label: gap between words (4T added to the 3T already done)
0000DE D80C           00148         RCALL DELAY_3T                 ; wait 3T
0000E0 D801           00149         RCALL DELAY_1T                 ; wait 1T more, so 4T in total
0000E2 0012           00150         RETURN                         ; go back to the caller
                      00151 
0000E4                00152 DELAY_1T                           ; label: 1T delay routine, 100 ms at 4 MHz
0000E4 0E64           00153         MOVLW D'100'                   ; load 100 into W (100 passes of 1 ms each)
0000E6 6E00           00154         MOVWF CNT_OUT                  ; store it in the outer counter
0000E8                00155 OUTER_LOOP                         ; label: start of one 1 ms pass
0000E8 0EF9           00156         MOVLW D'249'                   ; load 249 into W (number of inner iterations)
0000EA 6E01           00157         MOVWF CNT_IN                   ; store it in the inner counter
0000EC                00158 INNER_LOOP                         ; label: start of the inner loop
