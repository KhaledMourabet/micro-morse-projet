                      00001         #INCLUDE <P18F2520.INC>        ; load the register and bit names of the PIC18F2520
                      00001         LIST
                      00002 
                      00003 ;==========================================================================
                      00004 ;  MPASM PIC18F2520 processor include
                      00005 ; 
                      00006 ;  (c) Copyright 1999-2007 Microchip Technology, All rights reserved
                      00007 ;==========================================================================
                      00008 
                      01222         LIST
08 1F 1E 81 85 0F C0 000002         CONFIG OSC = INTIO67           ; use the internal oscillator, with RA6 and RA7 as normal I/O pin
                            s
       F E0 0F 40 
                      00003         CONFIG WDT = OFF               ; disable the watchdog timer so it never resets the program
                      00004         CONFIG PBADEN = OFF            ; make RB4:RB0 digital at reset, so RB0 can read the signal from 
                            PIC 1
                      00005 
  00000000            00006 GAP EQU 0X00                       ; address of the gap state: 0 = nothing reported, 1 = character end r
                            eported, 2 = word end reported
                      00007 
000000                00008         ORG 0X00                       ; place the code at the reset vector (address 0)
                      00009 
000000 0E60           00010         MOVLW B'01100000'              ; IRCF2:IRCF0 = 110, which selects 4 MHz for the internal oscilla
                            tor
000002 6ED3           00011         MOVWF OSCCON                   ; apply the 4 MHz clock setting
000004 0E19           00012         MOVLW D'25'                    ; SPBRG value for 9600 baud at 4 MHz with BRGH = 1
000006 6EAF           00013         MOVWF SPBRG                    ; load the baud rate generator
000008 0E24           00014         MOVLW B'00100100'              ; TXEN = 1 (enable transmit), SYNC = 0 (asynchronous), BRGH = 1 (
                            high speed)
00000A 6EAC           00015         MOVWF TXSTA                    ; configure the transmitter
00000C 0E80           00016         MOVLW B'10000000'              ; SPEN = 1 (enable serial port), CREN = 0 because this PIC only t
                            ransmits
00000E 6EAB           00017         MOVWF RCSTA                    ; turn on the serial port
000010 0E03           00018         MOVLW B'00000011'              ; TMR0ON = 0 (off), T08BIT = 0 (16-bit), T0CS = 0 (internal clock
                            ), PSA = 0, T0PS = 011 (1:16)
000012 6ED5           00019         MOVWF T0CON                    ; configure Timer0: one count every 16 us
000014 0E02           00020         MOVLW D'2'                     ; load 2 into W (the idle state)
000016 6E00           00021         MOVWF GAP                      ; start in the idle state, so nothing is reported before the firs
                            t pulse
                      00022 
000018                00023 LOW_WAIT                           ; label: wait in a LOW period for the next pulse, reporting gaps on t
                            he way
000018 B081           00024         BTFSC PORTB, 0                 ; skip the next line if RB0 = 0 (the signal is still low)
00001A D019           00025         BRA PULSE                      ; RB0 = 1: a new pulse starts
00001C 0E02           00026         MOVLW D'2'                     ; load 2 into W
00001E 6200           00027         CPFSEQ GAP                     ; skip the next line if gap = 2 (the word end was already reporte
                            d)
000020 D001           00028         BRA CHECK_GAP                  ; gap is 0 or 1: look at the timer
000022 D7FA           00029         BRA LOW_WAIT                   ; gap = 2: nothing left to report, keep waiting
000024                00030 CHECK_GAP                          ; label: compare the LOW time with the thresholds
000024 50D6           00031         MOVF TMR0L, W                  ; read the low byte, which also copies the timer's high byte into
                             TMR0H
000026 0E7A           00032         MOVLW 0X7A                     ; load the word threshold: 0x7A00 counts is about 5T (500 ms)
MPASM  5.34               RECEIVER-SOURCE.ASM   11-12-2026  15:08:27         PAGE  2


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

000028 60D7           00033         CPFSLT TMR0H                   ; skip the next line if the high byte is below the threshold
00002A D00B           00034         BRA WORD_EVENT                 ; LOW lasted 5T or more: it is the end of a word
00002C 6600           00035         TSTFSZ GAP                     ; skip the next line if gap = 0 (the character end was not report
                            ed yet)
00002E D7F4           00036         BRA LOW_WAIT                   ; gap = 1: already reported, keep waiting
000030 0E30           00037         MOVLW 0X30                     ; load the character threshold: 0x3000 counts is about 2T (200 ms
                            )
000032 60D7           00038         CPFSLT TMR0H                   ; skip the next line if the high byte is below the threshold
000034 D001           00039         BRA CHAR_EVENT                 ; LOW lasted 2T or more: it is the end of a character
000036 D7F0           00040         BRA LOW_WAIT                   ; threshold not reached yet, keep waiting
                      00041 
000038                00042 CHAR_EVENT                         ; label: the character is finished
000038 0E20           00043         MOVLW ' '                      ; load the ASCII code of a space
00003A D81C           00044         RCALL SEND_CHAR                ; print it on Terminal 2
00003C 0E01           00045         MOVLW D'1'                     ; load 1 into W
00003E 6E00           00046         MOVWF GAP                      ; remember that the character end has been reported
000040 D7EB           00047         BRA LOW_WAIT                   ; go back to waiting
                      00048 
000042                00049 WORD_EVENT                         ; label: the word is finished
000042 0E2F           00050         MOVLW '/'                      ; load the ASCII code of a slash
000044 D817           00051         RCALL SEND_CHAR                ; print it on Terminal 2
000046 0E02           00052         MOVLW D'2'                     ; load 2 into W
000048 6E00           00053         MOVWF GAP                      ; remember that the word end has been reported (idle state)
00004A 9ED5           00054         BCF T0CON, TMR0ON              ; stop Timer0, so it cannot overflow during a long silence
00004C D7E5           00055         BRA LOW_WAIT                   ; go back to waiting
                      00056 
00004E                00057 PULSE                              ; label: a HIGH pulse has started, measure it
00004E 6AD7           00058         CLRF TMR0H                     ; clear the high byte (written to the buffer first)
000050 6AD6           00059         CLRF TMR0L                     ; clear the low byte (this also loads the high byte into the time
                            r)
000052 8ED5           00060         BSF T0CON, TMR0ON              ; start Timer0 at the beginning of the pulse
000054                00061 WAIT_LOW                           ; label: wait for the end of the HIGH pulse
000054 B081           00062         BTFSC PORTB, 0                 ; skip the next line if RB0 = 0 (the signal went low)
000056 D7FE           00063         BRA WAIT_LOW                   ; signal still high, check again
000058 9ED5           00064         BCF T0CON, TMR0ON              ; stop Timer0 at the end of the pulse
00005A 50D6           00065         MOVF TMR0L, W                  ; read the low byte, which also copies the timer's high byte into
                             TMR0H
00005C 0E30           00066         MOVLW 0X30                     ; load the threshold: 0x3000 counts is about 2T (200 ms)
00005E 60D7           00067         CPFSLT TMR0H                   ; skip the next line if the high byte is below the threshold (a d
                            ot)
000060 D002           00068         BRA IS_DASH                    ; the pulse was long: it is a dash
000062 0E2E           00069         MOVLW '.'                      ; short pulse: load the ASCII code of a dot
000064 D001           00070         BRA SEND                       ; go and send it
000066                00071 IS_DASH                            ; label: the pulse was a dash
000066 0E2D           00072         MOVLW '-'                      ; load the ASCII code of a dash
000068                00073 SEND                               ; label: send the character in W to Terminal 2
000068 D805           00074         RCALL SEND_CHAR                ; transmit W through the UART
00006A 6A00           00075         CLRF GAP                       ; a new LOW period starts: nothing reported yet
00006C 6AD7           00076         CLRF TMR0H                     ; clear the high byte of the timer
00006E 6AD6           00077         CLRF TMR0L                     ; clear the low byte of the timer
000070 8ED5           00078         BSF T0CON, TMR0ON              ; start Timer0 to measure the LOW period
000072 D7D2           00079         BRA LOW_WAIT                   ; wait for the next pulse
                      00080 
MPASM  5.34               RECEIVER-SOURCE.ASM   11-12-2026  15:08:27         PAGE  3


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

000074                00081 SEND_CHAR                          ; label: sends the character in W through the UART
000074 A89E           00082         BTFSS PIR1, TXIF               ; skip the next line if TXIF = 1 (TXREG is empty)
000076 D7FE           00083         BRA SEND_CHAR                  ; transmitter still busy, check again
000078 6EAD           00084         MOVWF TXREG                    ; load the character into TXREG, which starts sending it
00007A 0012           00085         RETURN                         ; go back to the caller
                      00086 
                      00087         END                            ; end of the source file
