                      01222         LIST
08 1F 1E 81 85 0F C0 000002         CONFIG OSC = INTIO67           ; use the internal oscillator, with RA6 and RA7 as normal I/O pin
                            s
       F E0 0F 40 
                      00003         CONFIG WDT = OFF               ; disable the watchdog timer so it never resets the program
                      00004         CONFIG PBADEN = OFF            ; make RB4:RB0 digital at reset, so RB0 can read the signal from 
                            PIC 1
                      00005 
  00000000            00006 GAP      EQU 0X00                  ; address of the gap state: 0 = nothing reported, 1 = character end r
                            eported, 2 = word end reported
  00000001            00007 CODE_REG EQU 0X01                  ; address of the Morse code being built (starts at 1, the end marker)
  00000002            00008 INDEX    EQU 0X02                  ; address of the table entry counter used by the decoder
                      00009 
000000                00010         ORG 0X00                       ; place the code at the reset vector (address 0)
                      00011 
000000 0E60           00012         MOVLW B'01100000'              ; IRCF2:IRCF0 = 110, which selects 4 MHz for the internal oscilla
                            tor
000002 6ED3           00013         MOVWF OSCCON                   ; apply the 4 MHz clock setting
000004 0E19           00014         MOVLW D'25'                    ; SPBRG value for 9600 baud at 4 MHz with BRGH = 1
000006 6EAF           00015         MOVWF SPBRG                    ; load the baud rate generator
000008 0E24           00016         MOVLW B'00100100'              ; TXEN = 1 (enable transmit), SYNC = 0 (asynchronous), BRGH = 1 (
                            high speed)
00000A 6EAC           00017         MOVWF TXSTA                    ; configure the transmitter
00000C 0E80           00018         MOVLW B'10000000'              ; SPEN = 1 (enable serial port), CREN = 0 because this PIC only t
                            ransmits
00000E 6EAB           00019         MOVWF RCSTA                    ; turn on the serial port
000010 0E03           00020         MOVLW B'00000011'              ; TMR0ON = 0 (off), T08BIT = 0 (16-bit), T0CS = 0 (internal clock
                            ), PSA = 0, T0PS = 011 (1:16)
000012 6ED5           00021         MOVWF T0CON                    ; configure Timer0: one count every 16 us
000014 0E01           00022         MOVLW D'1'                     ; load 1 into W (the end marker, an empty code)
000016 6E01           00023         MOVWF CODE_REG                 ; start with an empty code
000018 0E02           00024         MOVLW D'2'                     ; load 2 into W (the idle state)
00001A 6E00           00025         MOVWF GAP                      ; start in the idle state, so nothing is reported before the firs
                            t pulse
00001C 0EEE           00026         MOVLW LOW INTRO                ; load the low byte of the intro text address
00001E 6EF6           00027         MOVWF TBLPTRL                  ; store it in the table pointer
000020 0E00           00028         MOVLW HIGH INTRO               ; load the high byte of the intro text address
000022 6EF7           00029         MOVWF TBLPTRH                  ; store it in the table pointer
000024 D85E           00030         RCALL SEND_STRING              ; print the intro text on Terminal 2
                      00031 
000026                00032 LOW_WAIT                           ; label: wait in a LOW period for the next pulse, reporting gaps on t
                            he way
000026 B081           00033         BTFSC PORTB, 0                 ; skip the next line if RB0 = 0 (the signal is still low)
000028 D01A           00034         BRA PULSE                      ; RB0 = 1: a new pulse starts
MPASM  5.34               RECEIVER-SOURCE.ASM   11-14-2026  10:46:07         PAGE  2


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

00002A 0E02           00035         MOVLW D'2'                     ; load 2 into W
00002C 6200           00036         CPFSEQ GAP                     ; skip the next line if gap = 2 (the word end was already reporte
                            d)
00002E D001           00037         BRA CHECK_GAP                  ; gap is 0 or 1: look at the timer
000030 D7FA           00038         BRA LOW_WAIT                   ; gap = 2: nothing left to report, keep waiting
000032                00039 CHECK_GAP                          ; label: compare the LOW time with the thresholds
000032 50D6           00040         MOVF TMR0L, W                  ; read the low byte, which also copies the timer's high byte into
                             TMR0H
000034 0E7A           00041         MOVLW 0X7A                     ; load the word threshold: 0x7A00 counts is about 5T (500 ms)
000036 60D7           00042         CPFSLT TMR0H                   ; skip the next line if the high byte is below the threshold
000038 D00C           00043         BRA WORD_EVENT                 ; LOW lasted 5T or more: it is the end of a word
00003A 6600           00044         TSTFSZ GAP                     ; skip the next line if gap = 0 (the character end was not report
                            ed yet)
00003C D7F4           00045         BRA LOW_WAIT                   ; gap = 1: already reported, keep waiting
00003E 0E30           00046         MOVLW 0X30                     ; load the character threshold: 0x3000 counts is about 2T (200 ms
                            )
000040 60D7           00047         CPFSLT TMR0H                   ; skip the next line if the high byte is below the threshold
000042 D001           00048         BRA CHAR_EVENT                 ; LOW lasted 2T or more: it is the end of a character
000044 D7F0           00049         BRA LOW_WAIT                   ; threshold not reached yet, keep waiting
                      00050 
000046                00051 CHAR_EVENT                         ; label: the character is finished
000046 D81E           00052         RCALL DECODE                   ; look up the built code, W = decoded character
000048 D836           00053         RCALL SEND_CHAR                ; print it on Terminal 2
00004A 0E01           00054         MOVLW D'1'                     ; load 1 into W
00004C 6E01           00055         MOVWF CODE_REG                 ; reset the code to the end marker, ready for the next character
00004E 6E00           00056         MOVWF GAP                      ; remember that the character end has been reported (W is still 1
                            )
000050 D7EA           00057         BRA LOW_WAIT                   ; go back to waiting
                      00058 
000052                00059 WORD_EVENT                         ; label: the word is finished
000052 0E20           00060         MOVLW ' '                      ; load the ASCII code of a space
000054 D830           00061         RCALL SEND_CHAR                ; print it on Terminal 2
000056 0E02           00062         MOVLW D'2'                     ; load 2 into W
000058 6E00           00063         MOVWF GAP                      ; remember that the word end has been reported (idle state)
00005A 9ED5           00064         BCF T0CON, TMR0ON              ; stop Timer0, so it cannot overflow during a long silence
00005C D7E4           00065         BRA LOW_WAIT                   ; go back to waiting
                      00066 
00005E                00067 PULSE                              ; label: a HIGH pulse has started, measure it
00005E 6AD7           00068         CLRF TMR0H                     ; clear the high byte (written to the buffer first)
000060 6AD6           00069         CLRF TMR0L                     ; clear the low byte (this also loads the high byte into the time
                            r)
000062 8ED5           00070         BSF T0CON, TMR0ON              ; start Timer0 at the beginning of the pulse
000064                00071 WAIT_LOW                           ; label: wait for the end of the HIGH pulse
000064 B081           00072         BTFSC PORTB, 0                 ; skip the next line if RB0 = 0 (the signal went low)
000066 D7FE           00073         BRA WAIT_LOW                   ; signal still high, check again
000068 9ED5           00074         BCF T0CON, TMR0ON              ; stop Timer0 at the end of the pulse
00006A 50D6           00075         MOVF TMR0L, W                  ; read the low byte, which also copies the timer's high byte into
                             TMR0H
00006C 0E30           00076         MOVLW 0X30                     ; load the threshold: 0x3000 counts is about 2T (200 ms)
00006E 60D7           00077         CPFSLT TMR0H                   ; skip the next line if the high byte is below the threshold (a d
                            ot)
000070 D002           00078         BRA IS_DASH                    ; the pulse was long: it is a dash
000072 90D8           00079         BCF STATUS, C                  ; dot: clear the carry, so a 0 will enter the code
MPASM  5.34               RECEIVER-SOURCE.ASM   11-14-2026  10:46:07         PAGE  3


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

000074 D001           00080         BRA ADD_ELEMENT                ; go and add the element
000076                00081 IS_DASH                            ; label: the pulse was a dash
000076 80D8           00082         BSF STATUS, C                  ; dash: set the carry, so a 1 will enter the code
000078                00083 ADD_ELEMENT                        ; label: add the element to the code
000078 3601           00084         RLCF CODE_REG, F               ; shift the code left and put the carry (0 or 1) into bit 0
00007A 6A00           00085         CLRF GAP                       ; a new LOW period starts: nothing reported yet
00007C 6AD7           00086         CLRF TMR0H                     ; clear the high byte of the timer
00007E 6AD6           00087         CLRF TMR0L                     ; clear the low byte of the timer
000080 8ED5           00088         BSF T0CON, TMR0ON              ; start Timer0 to measure the LOW period
000082 D7D1           00089         BRA LOW_WAIT                   ; wait for the next pulse
                      00090 
000084                00091 DECODE                             ; label: converts code_reg into its character in W ('?' if unknown)
000084 0EBE           00092         MOVLW LOW MORSE_TABLE          ; load the low byte of the table address
000086 6EF6           00093         MOVWF TBLPTRL                  ; store it in the table pointer
000088 0E00           00094         MOVLW HIGH MORSE_TABLE         ; load the high byte of the table address
00008A 6EF7           00095         MOVWF TBLPTRH                  ; store it in the table pointer
00008C 6A02           00096         CLRF INDEX                     ; start at table entry 0
00008E                00097 SEARCH                             ; label: compare the code with one table entry
00008E 0009           00098         TBLRD*+                        ; read the table entry into TABLAT, then move to the next entry
000090 5001           00099         MOVF CODE_REG, W               ; W = the code we built
000092 62F5           00100         CPFSEQ TABLAT                  ; skip the next line if the table entry equals the code
000094 D001           00101         BRA NEXT_ENTRY                 ; different: try the next entry
000096 D006           00102         BRA FOUND                      ; equal: the entry number in index is the answer
000098                00103 NEXT_ENTRY                         ; label: move on to the next table entry
000098 2A02           00104         INCF INDEX, F                  ; count one more entry
00009A 0E24           00105         MOVLW D'36'                    ; load 36 into W (the number of entries in the table)
00009C 6202           00106         CPFSEQ INDEX                   ; skip the next line if all 36 entries have been tried
00009E D7F7           00107         BRA SEARCH                     ; entries remain, keep searching
0000A0 0E3F           00108         MOVLW '?'                      ; no entry matched: load a question mark
0000A2 0012           00109         RETURN                         ; go back to the caller
0000A4                00110 FOUND                              ; label: index holds the position of the matching entry
0000A4 0E1A           00111         MOVLW D'26'                    ; load 26 into W (the first digit entry)
0000A6 6002           00112         CPFSLT INDEX                   ; skip the next line if index < 26 (a letter)
0000A8 D003           00113         BRA DIGIT                      ; index is 26 or more: it is a digit
0000AA 0E41           00114         MOVLW 'A'                      ; letter: load the ASCII code of 'A'
0000AC 2402           00115         ADDWF INDEX, W                 ; W = 'A' + index
0000AE 0012           00116         RETURN                         ; go back to the caller
0000B0                00117 DIGIT                              ; label: the entry is a digit
0000B0 0E16           00118         MOVLW D'22'                    ; load 22 into W ('0' is 48, and 48 - 26 = 22)
0000B2 2402           00119         ADDWF INDEX, W                 ; W = index + 22, the ASCII code of the digit
0000B4 0012           00120         RETURN                         ; go back to the caller
                      00121 
0000B6                00122 SEND_CHAR                          ; label: sends the character in W through the UART
0000B6 A89E           00123         BTFSS PIR1, TXIF               ; skip the next line if TXIF = 1 (TXREG is empty)
0000B8 D7FE           00124         BRA SEND_CHAR                  ; transmitter still busy, check again
0000BA 6EAD           00125         MOVWF TXREG                    ; load the character into TXREG, which starts sending it
0000BC 0012           00126         RETURN                         ; go back to the caller
                      00127 
0000BE                00128 MORSE_TABLE                        ; label: codes in arrival order with a leading 1 marker, A to Z then 
                            0 to 9
0000BE 1805 0C1A 1202 00129         DB 0X05, 0X18, 0X1A, 0X0C, 0X02, 0X12, 0X0E, 0X10, 0X04, 0X17   ; codes for A B C D E F G H I J
       100E 1704 
0000C8 140D 0607 160F 00130         DB 0X0D, 0X14, 0X07, 0X06, 0X0F, 0X16, 0X1D, 0X0A, 0X08, 0X03   ; codes for K L M N O P Q R S T
